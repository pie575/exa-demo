{
  "name": "exa-docs-local",
  "version": "1.0.0",
  "private": true,
  "description": "Local Mintlify mirror of Exa's production documentation",
  "scripts": {
    "dev": "mint dev --no-open --port 3000",
    "validate": "mint validate",
    "check:links": "mint broken-links",
    "predev": "python3 scripts/build-search-index.py",
    "audit:content": "python3 verification/audit-content.py"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "mint": "4.2.905",
    "playwright": "1.63.0"
  }
}
