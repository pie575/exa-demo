{
  "theme": "aspen",
  "$schema": "https://mintlify.com/docs.json",
  "name": "Exa",
  "colors": {
    "primary": "#1840ED",
    "light": "#5F7CFF",
    "dark": "#2751F6"
  },
  "logo": {
    "light": "/docs/logo/light.svg",
    "dark": "/docs/logo/dark.svg",
    "href": "/docs/search/quickstart"
  },
  "favicon": "/docs/images/favicon-32x32.png",
  "api": {
    "playground": {
      "proxy": false
    },
    "examples": {
      "languages": [
        "python",
        "javascript",
        "bash"
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "href": "https://exa.ai/blog",
        "label": "Blog"
      }
    ],
    "primary": {
      "type": "button",
      "label": "API Dashboard",
      "href": "https://dashboard.exa.ai/login?redirect=/"
    }
  },
  "footer": {
    "socials": {
      "x": "https://twitter.com/exaailabs",
      "linkedin": "https://www.linkedin.com/company/exa-ai"
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://exa.ai/docs",
      "og:type": "website",
      "og:site_name": "Exa Docs"
    },
    "organization": {
      "id": "https://exa.ai/#organization",
      "name": "Exa",
      "legalName": "Exa Labs Inc.",
      "url": "https://exa.ai",
      "logo": "https://exa.imgix.net/logo_cream.png",
      "sameAs": [
        "https://x.com/exaailabs",
        "https://www.linkedin.com/company/exa-ai/",
        "https://github.com/exa-labs"
      ]
    },
    "indexing": "navigable"
  },
  "fonts": {
    "heading": {
      "family": "ABCDiatype",
      "weight": 700,
      "source": "/fonts/ABCDiatype-Bold.woff2",
      "format": "woff2"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "This URL does not exist. The index of every docs page is at [https://exa.ai/docs/llms.txt](https://exa.ai/docs/llms.txt) and the full documentation in one file is at [https://exa.ai/docs/llms-full.txt](https://exa.ai/docs/llms-full.txt). Append `.md` to any docs URL to get the page as Markdown."
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "metadata": {
    "timestamp": true
  },
  "styling": {
    "latex": false,
    "codeblocks": "system"
  },
  "navigation": {
    "global": {
      "anchors": []
